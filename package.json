{
  "name": "vstest-nanoframework",
  "description": "Runs nanoFramework unit tests with VSTest and uploads the results",
  "version": "0.0.0",
  "author": "CCSWE",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/ccswe-nanoframework/vstest-nanoframework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccswe-nanoframework/vstest-nanoframework.git"
  },
  "bugs": {
    "url": "https://github.com/ccswe-nanoframework/vstest-nanoframework/issues"
  },
  "keywords": [
    "actions",
    "node",
    "nanoframework",
    "vstest",
    "test",
    "runner",
    "github",
    "github-actions",
    "github-action",
    "github-actions-runner"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "build:watch": "npm run build -- --watch",
    "all": "npm run format && npm run lint && npm run test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.7.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "eslint": "$eslint",
    "eslint-plugin-eslint-comments": "npm:@eslint-community/eslint-plugin-eslint-comments@latest",
    "prettier-eslint": {
      "minimatch": ">=9.0.7"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
